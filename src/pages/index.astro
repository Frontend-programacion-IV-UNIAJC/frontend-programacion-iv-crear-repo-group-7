---
import Layout from "../layouts/Layout.astro";
import Boton from "../Components/ui/Boton.astro";

const base = import.meta.env.BASE_URL;

// Accesos rapidos (fila de 4 del mockup: icono a la izquierda, texto a la derecha)
const accesos = [
  { texto: "Ofertas", icono: "🏷️", ruta: "ofertas" },
  { texto: "Envío rápido", icono: "🚚", ruta: "catalogo" },
  { texto: "Electrónica", icono: "🎧", ruta: "catalogo?categoria=laptops" },
  { texto: "Moda", icono: "👟", ruta: "catalogo?categoria=womens-shoes" },
];

// Mosaico de ofertas (4 tarjetas + "Ver todas"). Las tarjetas reales llegan en la clase 5.
const ofertas = [
  { texto: "Smartphone", icono: "📱", ruta: "catalogo?categoria=smartphones" },
  { texto: "Licuadora", icono: "🥤", ruta: "catalogo?categoria=kitchen-accessories" },
  { texto: "Auriculares", icono: "🎧", ruta: "catalogo?categoria=mobile-accessories" },
  { texto: "Zapatillas", icono: "👟", ruta: "catalogo?categoria=womens-shoes" },
];

const categorias = [
  { texto: "Celulares", ruta: "catalogo?categoria=smartphones" },
  { texto: "Hogar", ruta: "catalogo?categoria=home-decoration" },
  { texto: "Computación", ruta: "catalogo?categoria=laptops" },
  { texto: "Belleza", ruta: "catalogo?categoria=beauty" },
];
---
<Layout
  titulo="VitrinaDemo — Encuentra y compara productos en un solo lugar"
  descripcion="Catálogo con filtros por categoría y precio, descuentos y calificaciones a la vista, para comprar rápido desde el celular."
  activo="inicio"
  ancho="ancho"
>
  <div class="contenedor inicio">
    <!-- Buscador -->
    <form class="buscador" action={`${base}catalogo`} method="get" role="search">
      <label class="solo-lectores" for="q">Buscar productos, marcas y más</label>
      <input id="q" name="q" type="search" placeholder="Buscar productos, marcas y más…" />
      <button type="submit" aria-label="Buscar">🔍</button>
    </form>

    <!-- Banner principal (aqui va la imagen del banner cuando la tengan) -->
    <section class="banner">
      <h1>Compara productos sin abrir cinco pestañas</h1>
      <p>Precio, descuento y calificación en cada producto.</p>
      <div class="banner__acciones">
        <Boton href={`${base}catalogo`} tamano="grande">Ver el catálogo</Boton>
        <Boton href={`${base}ofertas`} variante="secundario" tamano="grande">Ir a ofertas</Boton>
      </div>
    </section>

    <!-- Accesos rapidos -->
    <ul class="accesos" aria-label="Accesos rápidos">
      {accesos.map((a) => (
        <li>
          <a class="acceso" href={`${base}${a.ruta}`}>
            <span class="caja-img" aria-hidden="true">{a.icono}</span>
            <span class="acceso__texto">{a.texto}</span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Ofertas imperdibles -->
    <section aria-labelledby="t-ofertas">
      <div class="barra">
        <h2 id="t-ofertas">¡Ofertas imperdibles!</h2>
        <a class="barra__enlace" href={`${base}ofertas`}>Ver más &gt;</a>
      </div>
      <ul class="ofertas">
        {ofertas.map((o) => (
          <li>
            <a class="oferta" href={`${base}${o.ruta}`}>
              <span class="caja-img caja-img--grande" aria-hidden="true">{o.icono}</span>
              <span class="oferta__texto">{o.texto}</span>
            </a>
          </li>
        ))}
        <li class="ofertas__todas">
          <a class="oferta oferta--todas" href={`${base}catalogo`}>Ver todas &gt;</a>
        </li>
      </ul>
    </section>

    <!-- Categorias populares -->
    <section class="categorias" aria-labelledby="t-cat">
      <h2 id="t-cat">Categorías populares</h2>
      <ul class="categorias__lista">
        {categorias.map((c) => (
          <li><a class="chip" href={`${base}${c.ruta}`}>{c.texto}</a></li>
        ))}
      </ul>
    </section>

    <!-- Beneficios -->
    <ul class="beneficios" aria-label="Beneficios">
      <li><span aria-hidden="true">🚚</span> Envíos a todo el país</li>
      <li><span aria-hidden="true">🛡️</span> Pago seguro</li>
      <li><span aria-hidden="true">↩️</span> Devolución garantizable</li>
    </ul>
  </div>
</Layout>

<style>
  .inicio {
    display: grid;
    gap: var(--esp-3);
    padding-top: var(--esp-3);
  }

  /* ---- Buscador ---- */
  .buscador {
    display: flex;
    align-items: center;
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-pill);
    padding: 0 var(--esp-2) 0 var(--esp-3);
  }
  .buscador input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    font: inherit;
    font-weight: 600;
    color: var(--color-texto);
  }
  .buscador input:focus-visible { outline: none; }
  .buscador:focus-within {
    outline: 3px solid var(--color-marca-oscuro);
    outline-offset: 2px;
  }
  .buscador button {
    min-width: 44px;
    min-height: 44px;
    border: 0;
    background: transparent;
    font-size: var(--texto-l);
    cursor: pointer;
  }

  /* ---- Banner ---- */
  .banner {
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio-s);
    padding: var(--esp-5) var(--esp-4);
    text-align: center;
  }
  .banner h1 { margin-inline: auto; max-width: 22ch; }
  .banner p { color: var(--color-texto-suave); font-size: var(--texto-M); }
  .banner__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--esp-2);
  }

  /* ---- Piezas comunes ---- */
  .caja-img {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    font-size: var(--texto-xl);
  }
  .caja-img--grande { width: 100%; height: auto; aspect-ratio: 4 / 3; }

  /* ---- Accesos rapidos ---- */
  .accesos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--esp-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .accesos { grid-template-columns: repeat(4, 1fr); }
  }
  .acceso {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-2);
    padding: var(--esp-2);
    background: var(--color-marca);
    border: 1px solid var(--color-marca-oscuro);
    color: var(--color-texto);
    font-weight: 700;
    text-decoration: none;
  }
  .acceso:hover { color: var(--color-texto); box-shadow: var(--sombra-2); }

  /* ---- Barra de seccion ---- */
  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-3);
    padding: var(--esp-2) var(--esp-4);
    background: var(--color-marca);
    margin-bottom: var(--esp-3);
  }
  .barra h2 { margin: 0; font-size: var(--texto-M); font-weight: 500; }
  .barra__enlace { color: var(--color-texto); font-weight: 700; }

  /* ---- Mosaico de ofertas ---- */
  .ofertas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--esp-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ofertas__todas { grid-column: 1 / -1; }
  @media (min-width: 768px) {
    .ofertas { grid-template-columns: repeat(5, 1fr); }
    .ofertas__todas { grid-column: auto; }
  }
  .oferta {
    display: flex;
    flex-direction: column;
    gap: var(--esp-2);
    height: 100%;
    padding: var(--esp-2);
    background: var(--color-marca);
    border: 1px solid var(--color-marca-oscuro);
    color: var(--color-texto);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }
  .oferta:hover { color: var(--color-texto); box-shadow: var(--sombra-2); }
  .oferta--todas {
    justify-content: center;
    min-height: 64px;
    font-size: var(--texto-l);
  }

  /* ---- Categorias populares: titulo a la izquierda, chips llenando la barra ---- */
  .categorias {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--esp-2) var(--esp-3);
    background: var(--color-marca);
  }
  .categorias h2 {
    margin: 0;
    padding: var(--esp-3) var(--esp-4);
    font-size: var(--texto-M);
    font-weight: 500;
    align-self: center;
  }
  .categorias__lista {
    flex: 1 1 320px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .categorias__lista { grid-template-columns: repeat(4, 1fr); }
  }
  .chip {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    height: 100%;
    background: var(--color-chip);
    color: var(--color-chip-texto);
    font-weight: 700;
    text-decoration: none;
  }
  .chip:hover { background: #000; color: var(--color-chip-texto); }

  /* ---- Beneficios (banner inferior) ---- */
  .beneficios {
    display: grid;
    gap: var(--esp-3);
    list-style: none;
    margin: 0;
    padding: var(--esp-4);
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    font-weight: 700;
    font-size: var(--texto-s);
  }
  @media (min-width: 768px) {
    .beneficios { grid-template-columns: repeat(3, 1fr); }
  }
  .beneficios li { display: flex; align-items: center; gap: var(--esp-3); }
  .beneficios span { font-size: var(--texto-xl); }
</style>