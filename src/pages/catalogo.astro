---
import Layout from "../layouts/Layout.astro";
import Filtros from "../catalogo/Filtros.astro";
import BarraDeBusqueda from "../catalogo/BarraDeBusqueda.astro";
import CardGrid from "../catalogo/CardGrid.astro";
import Paginacion from "../catalogo/Paginacion.astro";
import { recetas, categorias, dificultades } from "../Data/datos-de-pruebas.js";
---

<Layout
titulo="Catalogo — SaborU"
    descripcion="Catalogo de recetas rapidas con tiempo y dificultad visibles."
    activo="catalogo"
>
    <div class="contenedor">
        <p class="rotulo">Catalogo</p>
        <h1>Que puedes cocinar hoy</h1>
        <p class="entrada">
            Filtra por categoria o por dificultad. Cada ficha indica cuanto tarda de
            verdad, no cuanto dura el video.
        </p>

        <div class="catalogo">
            <Filtros categorias={categorias} dificultades={dificultades} />

            <div class="catalogo__resultados">
                <BarraDeBusqueda />
                <p class="catalogo__conteo" role="status">
                    <strong>{recetas.length}</strong> recetas encontradas
                </p>
                <CardGrid recetas={recetas} />
                <Paginacion actual={1} total={3} />
            </div>
        </div>
    </div>
    </Layout>

<Layout
  titulo="Catálogo — VitrinaDemo"
  descripcion="Catálogo de productos con filtros por categoría y precio, y orden por precio o popularidad."
  activo="catalogo"
>
  <section class="contenedor">
    <h1>Encuentra lo que buscas</h1>
    <p class="entrada">Filtra por categoría y precio, y ordena por precio o popularidad.</p>
    <div class="pendiente">Se construye en la clase 5.</div>
  </section>

</Layout>

<style>
  .entrada {
    max-width: var(--ancho-lectura);
    color: var(--color-texto-suave);
  }


  /* Celular: filtros arriba y resultados debajo (una sola columna) */
  .catalogo {
    display: grid;
    gap: var(--esp-4);
    margin-top: var(--esp-5);
  }

  /* Escritorio: barra lateral de 240 px y el resto para las tarjetas */
  @media (min-width: 900px) {
    .catalogo {
      grid-template-columns: 240px 1fr;
      gap: var(--esp-5);
      align-items: start;
    }
  }

  .catalogo__resultados {
    min-width: 0; /* un hijo de Grid no se encoge por debajo de su contenido sin esto */
  }

  .catalogo__conteo {
    margin: var(--esp-3) 0;
    font-size: var(--texto-s);
    color: var(--color-texto-suave);
  }

  .catalogo__conteo strong {
    color: var(--color-texto);
  }


 
  .pendiente {
    margin-top: var(--esp-5);
    padding: var(--esp-6) var(--esp-4);
    border: 2px dashed var(--color-texto-tenue);
    border-radius: var(--radio-m);
    color: var(--color-texto);
    text-align: center;
  }
</style>