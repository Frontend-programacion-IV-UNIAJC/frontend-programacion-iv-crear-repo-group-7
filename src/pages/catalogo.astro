---
import Layout from "../layouts/Layout.astro";
---
<Layout
  titulo="Catálogo — VitrinaDemo"
  descripcion="Catálogo de productos con filtros por categoría y precio, y orden por precio o popularidad."
  activo="catalogo"
>
  <section class="contenedor">
    <h1>Encuentra lo que buscas</h1>
    <p class="entrada">Filtra por categoría y precio, y ordena por precio o popularidad.</p>
    <div class="pendiente">Se construye en la clase 5.</div>
  </section>
</Layout>

<style>
  .entrada {
    max-width: var(--ancho-lectura);
    color: var(--color-texto-suave);
  }
  .pendiente {
    margin-top: var(--esp-5);
    padding: var(--esp-6) var(--esp-4);
    border: 2px dashed var(--color-texto-tenue);
    border-radius: var(--radio-m);
    color: var(--color-texto);
    text-align: center;
  }
</style>
